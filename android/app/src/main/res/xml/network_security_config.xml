<?xml version="1.0" encoding="utf-8"?>
<!--
  Bug fix (Android device testing, issues #1/#5): "AI Gateway unavailable"
  and "no external connection despite internet being on" both traced back
  to the same root cause chain -

    1. VITE_AI_BASE_URL is never set at build time, so a packaged APK
       defaulted to same-origin requests that go nowhere (see
       apps/mobile/src/lib/config.ts).
    2. Fixed by letting the user set a gateway address at runtime from
       ChatTab - but that address is necessarily a plain http:// LAN IP
       (e.g. http://192.168.1.10:8787), since Capacitor's WebView origin
       is "https://localhost" and there's no way to get a real TLS
       certificate for an arbitrary home/hotel LAN address.
    3. Android blocks all cleartext (non-TLS) traffic by default on API 28+
       regardless of the WebView-level allowMixedContent setting in
       capacitor.config.ts (that setting alone is necessary but not
       sufficient) - this file is what permits it at the OS/network-stack
       level.

  Scoped to cleartext only (not disabling certificate validation for TLS
  connections) and only matters when the learner has explicitly typed in
  their own local gateway address - nothing here affects any other traffic.
  A domain-config can't express "any private LAN IP" (no CIDR support), so
  this is intentionally app-wide rather than pretending to scope it to a
  specific host.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
