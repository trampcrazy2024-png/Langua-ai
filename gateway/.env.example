# Local-first routing
OLLAMA_BASE_URL=http://localhost:11434
# Optional exact preference; first installed match wins. Any Ollama model is supported.
OLLAMA_MODEL_PREFERENCE=qwen3:4b,qwen3-4b
OLLAMA_MODEL=
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_TIMEOUT=45
PROVIDER_COOLDOWN=20

# Optional cloud fallbacks. "Free" availability/quotas are controlled by each provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M2.7
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# Any OpenAI-compatible endpoint(s), optional. Do not commit secrets.
# PROVIDERS_JSON=[{"name":"my-server","base_url":"http://127.0.0.1:1234/v1","model":"local-model","api_key":"","capabilities":["chat"]}]
