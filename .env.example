# Local AI gateway
# These are the exact names server.ts reads (see server.ts). Earlier drafts of
# this file used an AI_ prefix (AI_GATEWAY_URL etc.) that server.ts never
# actually read, so copying it as .env silently configured nothing - fixed.
GATEWAY_URL=http://127.0.0.1:8080/v1/chat/completions
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
SERVER_MAX_TOKENS=1200
GATEWAY_CALL_TIMEOUT=120000
TRAVELAPP_SHARED_SECRET=

# AI_BACKEND selects how server.ts gets AI completions:
#   gateway (default) - calls the Python gateway/gateway.py over HTTP, at
#                        GATEWAY_URL above. Nothing changes if you leave this
#                        unset.
#   node               - routes in-process via aiRouter.ts, no Python process
#                        needed. Reads the same provider env vars below (they
#                        are shared with gateway/.env.example on purpose).
#                        This is step 1 of migrating off gateway.py - see
#                        README.md before switching this in production.
AI_BACKEND=gateway

# Gateway provider settings (Ollama, DeepSeek, MiniMax, GLM, Kimi, custom
# OpenAI-compatible providers) live in gateway/.env.example. GATEWAY_URL above
# must point at the same host/port the gateway is actually listening on
# (GATEWAY_HOST/GATEWAY_PORT in gateway/.env.example, default 0.0.0.0:8080).
# If you set AI_BACKEND=node, copy the same OLLAMA_*/DEEPSEEK_*/MINIMAX_*/
# GLM_*/KIMI_*/PROVIDERS_JSON values from gateway/.env.example into this file
# instead - aiRouter.ts reads them directly from this process's env.
